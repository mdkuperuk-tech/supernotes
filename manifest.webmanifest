{
  "name": "SuperNotes",
  "short_name": "SuperNotes",
  "description": "Handwritten notebooks, a daily journal and a daily to-do, synced to your Google Drive.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0f1216",
  "theme_color": "#111418",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "./icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Today's journal", "url": "./index.html?go=journal" },
    { "name": "Today's to-do", "url": "./index.html?go=todo" }
  ]
}
